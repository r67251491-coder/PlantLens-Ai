# ==============================================================================
# PlantLens AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate the values below.
# Never commit your actual .env or .env.local files to Git.

# 1. Gemma / Google AI Studio API Key (Server-Side Only)
# Obtain your free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMMA_API_KEY=your_api_key_here

# 2. Gemma Model Identifier
# Supported multimodal Gemma models:
# - gemma-3-27b-it (Recommended for highest fidelity plant reasoning)
# - gemma-3-12b-it (Fast balanced multimodal reasoning)
# - gemma-3-4b-it  (Ultra-lightweight multimodal)
# (Fallback: gemini-2.5-flash if testing within standard AI Studio tier)
GEMMA_MODEL=gemma-3-27b-it

# 3. Optional: Custom Endpoint (for Local Ollama or OpenRouter)
# Leave blank to use official Google AI Studio endpoint
# Ollama example: http://localhost:11434/v1
# OpenRouter example: https://openrouter.ai/api/v1
GEMMA_API_ENDPOINT=

# 4. Demo Mode Toggle (enabled by default so anyone can test instantly)
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
